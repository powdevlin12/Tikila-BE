# syntax=docker/dockerfile:1
FROM node:22-alpine
WORKDIR /app/tikila-BE

COPY package*.json ./
RUN npm ci

COPY . .
RUN mkdir -p /app/uploads/images/temp /app/uploads/videos/temp

EXPOSE 1236
# -L (legacy polling) để nodemon nhận thay đổi qua bind mount trên macOS/Windows
CMD ["npx", "nodemon", "-L", "--env=development"]
