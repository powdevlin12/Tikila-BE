# ============================================================
# Biến môi trường cho docker-compose.yml (production).
# docker compose tự đọc file .env này, không cần --env-file.
# KHÔNG commit file này.
# ============================================================

# ---- Cổng publish ra host ----
FE_PORT=5004
ADMIN_PORT=4005
BE_PORT=1236

# ---- MariaDB ----
# Đổi mật khẩu root này trước khi deploy thật
MARIADB_ROOT_PASSWORD=P5VGOmVj6jqgPxywG3zBOjGe
MYSQL_DATABASE=jetwash
MYSQL_USERNAME=td_tikila
MYSQL_PASSWORD=td_tikila

# ---- Backend (tikila-BE) ----
# MYSQL_HOST / MYSQL_PORT / PORT_SERVER được set cứng trong compose, đừng thêm ở đây
ADMIN_USER_DEFAULT=admin@gmail.com
ADMIN_PASSWORD_DEFAULT=!Thudat123

JWT_SECRET_ACCESS_TOKEN=@tadudTVanvosongtoan@
JWT_SECRET_REFRESH_TOKEN=@tadudTVanvosongtoan@123
JWT_SECRET_EMAIL_VERIFY_TOKEN=@tadudTVanvosongtoan@123@
JWT_SECRET_FORGOT_PASSWORD_VERIFY_TOKEN=@tadudTVanvosongtoan@123@@@
ACCESS_TOKEN_EXPIRE_IN=10d
REFRESH_TOKEN_EXPIRE_IN=100d
EMAIL_VERIFY_TOKEN_EXPIRE_IN=1d
FORGOT_PASSWORD_VERIFY_TOKEN_EXPIRE_IN=7d

CLOUDINARY_CLOUD_NAME=dkwyn4prj
CLOUDINARY_API_KEY=182839932662639
CLOUDINARY_API_SECRET=5eDimgH0WaD9e_vOtSLA62a9nHk

# ---- Frontend ----
# NEXT_PUBLIC_* và VITE_* chạy trên trình duyệt -> phải là URL công khai.
# Inline vào bundle lúc build, đổi giá trị thì phải build lại image.
NEXT_PUBLIC_API_BASE_URL=https://powdevlin68.info/api
VITE_API_BASE_URL=https://powdevlin68.info/api

# API_BASE_URL chỉ dùng ở server component (services/server.ts) -> gọi thẳng
# service nội bộ, khỏi vòng ra internet + TLS.
API_BASE_URL=http://tikila-be:1236

# Lúc build image thì chưa vào được mạng compose, nên với tới cổng đã publish.
BUILD_API_BASE_URL=http://127.0.0.1:1236
